# FlySaaS SuperOrg - Environment Variables

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flysaas

# Auth (Better-Auth)
JWT_SECRET=local-dev-secret-change-in-production
BASE_URL=http://localhost:3000
JWKS_URL=http://localhost:3000/auth/jwks

# Fly.io (for provisioning)
FLY_API_TOKEN=your-fly-api-token-here

# SuperOrg URL (for client orgs)
SUPERORG_JWKS_URL=http://localhost:3000/auth/jwks
